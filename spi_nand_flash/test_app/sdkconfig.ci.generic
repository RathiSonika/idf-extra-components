CONFIG_NAND_FLASH_ENABLE_BDL=y
CONFIG_NAND_FLASH_GENERIC_CHIP_DETECTION=y
# OTP fallback if parameter page unavailable (page-0 probe needs correct page size)
CONFIG_NAND_FLASH_GENERIC_GEOMETRY_PAGE_SIZE=2048
CONFIG_NAND_FLASH_GENERIC_GEOMETRY_PAGES_PER_BLOCK=64
CONFIG_NAND_FLASH_GENERIC_GEOMETRY_NUM_BLOCKS=1024
